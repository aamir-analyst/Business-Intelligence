          <datasource-dependencies datasource='federated.0wjbfba0t7podz10i8ygd0r8nwkg'>
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column caption='Total PY Profit ' datatype='real' name='[Total CY Profit (copy)_0963773010657285]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date])= {MAX(YEAR([Order Date]))} -1 THEN [Profit] END' />
            </column>
            <column caption='Total CY Profit' datatype='real' name='[Total CY sales (copy)_0963773010173956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date])= {MAX(YEAR([Order Date]))} THEN [Profit] END' />
            </column>
            <column caption='YOY  Profit  indicator ' datatype='string' name='[YOY  Sales indicator (copy)_0963773011410951]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [YOY Sales (copy)_0963773010993158] &gt; 0 THEN &quot;▲&quot; ELSE &quot;▼&quot; END' />
            </column>
            <column caption='YOY Profit' datatype='real' name='[YOY Sales (copy)_0963773010993158]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Total CY sales (copy)_0963773010173956]) - SUM([Total CY Profit (copy)_0963773010657285]))/SUM([Total CY Profit (copy)_0963773010657285])' />
            </column>
